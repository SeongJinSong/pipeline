# ── Slack (mujuhoney 워크스페이스) ─────────────────────────
SLACK_BOT_TOKEN=xoxb-...
# Basic Information → App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-...
# 코드 변경·배포를 요청/승인할 수 있는 사람 (Slack Member ID, 쉼표 구분)
SLACK_ALLOWED_USERS=U0XXXXXXX,U0YYYYYYY
SLACK_CHANNEL_PREFIX=app-
# /newapp 진행 로그를 남길 채널 ID (비우면 요청자 DM)
SLACK_LAUNCH_CHANNEL=

# ── Claude ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
AGENT_MAX_BUDGET_USD=10

# ── GitHub ────────────────────────────────────────────────
# Fine-grained PAT: Administration(RW), Contents(RW), Pull requests(RW), Secrets(RW), Variables(RW), Workflows(RW)
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=SeongJinSong
GITHUB_PRIVATE_REPOS=true

# ── Vercel ────────────────────────────────────────────────
# vercel.com/account/tokens  (Vercel GitHub App 이 GITHUB_OWNER 에 설치되어 있어야 함)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ── AWS (선택: 백엔드 필요한 앱) ───────────────────────────
# infra/bootstrap 를 1회 apply 한 출력값
AWS_REGION=ap-northeast-2
AWS_DEPLOY_ROLE_ARN=
AWS_TF_STATE_BUCKET=
