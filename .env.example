# ── Slack (mujuhoney 워크스페이스) ─────────────────────────
SLACK_BOT_TOKEN=xoxb-...
# Basic Information → App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-...
# 코드 변경·배포를 요청/승인할 수 있는 사람 (Slack Member ID, 쉼표 구분)
# true 면 워크스페이스 누구나 앱 만들기·수정 요청·배포 버튼 사용 (내부 소수 인원용). 레포 연결/삭제는 SLACK_ALLOWED_USERS 만
SLACK_OPEN_ACCESS=false
SLACK_ALLOWED_USERS=U0XXXXXXX,U0YYYYYYY
SLACK_CHANNEL_PREFIX=app-
# /newapp 진행 로그를 남길 채널 ID (비우면 요청자 DM)
SLACK_LAUNCH_CHANNEL=

# ── Claude ────────────────────────────────────────────────
# AGENT_RUNNER=sdk 일 때만 필요 (claude-cli 는 로컬 Claude Code 로그인 사용)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 스펙 정리·코드 수정 실행 방식
#   claude-cli: 이 맥에 로그인된 Claude Code(구독)로 실행 → API 키·토큰 과금 없음 (기본)
#   sdk:        Messages API / Agent SDK + ANTHROPIC_API_KEY 종량제 (상시 서버용)
AGENT_RUNNER=claude-cli
CLAUDE_BIN=claude
# sdk 러너일 때만 적용되는 작업당 비용 상한(USD)
AGENT_MAX_BUDGET_USD=10

# ── GitHub ────────────────────────────────────────────────
# Fine-grained PAT: Administration(RW), Contents(RW), Issues(RW), Pull requests(RW), Secrets(RW), Variables(RW), Workflows(RW)
GITHUB_TOKEN=github_pat_...
# 앱마다 GitHub Project 보드 생성 (선택). 개인 계정 Project 는 fine-grained PAT 로 못 만들어서
# classic PAT(scope: project, repo)를 넣어야 해요. 비우면 GITHUB_TOKEN 으로 시도하고 실패하면 보드 없이 진행
GITHUB_PROJECT_TOKEN=
GITHUB_PROJECTS=true
GITHUB_OWNER=SeongJinSong
GITHUB_PRIVATE_REPOS=true

# ── Vercel ────────────────────────────────────────────────
# vercel.com/account/tokens  (Vercel GitHub App 이 GITHUB_OWNER 에 설치되어 있어야 함)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ── AWS (선택: 백엔드 필요한 앱) ───────────────────────────
# infra/bootstrap 를 1회 apply 한 출력값
AWS_REGION=ap-northeast-2
AWS_DEPLOY_ROLE_ARN=
AWS_TF_STATE_BUCKET=

# ── 앱인토스 (선택: 토스 미니앱으로도 내는 앱) ─────────────────
# (선택) 앱인토스 콘솔 → 워크스페이스 → '키' 메뉴에서 발급. 있으면 번들 업로드는 키로, 없으면 콘솔 MCP 로 (둘 다 없으면 건너뜀)
APPS_IN_TOSS_API_KEY=
# true: 서버 Claude Code 에 등록·로그인한 앱인토스 콘솔 MCP 사용 (Slack '@pipeline 콘솔 …', 키 없는 번들 업로드). deploy/README 참고
TOSS_CONSOLE_MCP=false
# PR마다 테스트 번들을 올려 토스앱 테스트 링크를 스레드에 남길지 (출시는 콘솔에서 사람이)
APPS_IN_TOSS_PR_UPLOADS=true
